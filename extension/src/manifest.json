{
  "manifest_version": 3,
  "name": "Zen Extension MCP Bridge",
  "short_name": "zen-ext-mcp",
  "version": "0.0.19",
  "description": "Bridges Zen/Firefox to the zen-mcp daemon over a localhost WebSocket so MCP clients can drive container-scoped browser automation.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-ext-mcp@cxrobx",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
